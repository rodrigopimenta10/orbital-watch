# Site output of a local run or of the deploy workflow: the frontend plus a
# baked copy of the document. dist.staging/ and dist.previous/ are the
# atomic-swap workspaces; an interrupted build can orphan them, and they must
# never be committed.
dist/
dist.staging/
dist.previous/
dist-*/

# What a local run keeps where the deployed job uses its two buckets:
# per-source state and the published document.
.local*/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local editor/agent settings. Ignored here rather than relying on a personal
# global gitignore, so it stays ignored on any clone.
.claude/settings.local.json

# Firebase CLI local state (created by firebase login/deploy)
.firebase/
firebase-debug.log

# OS
.DS_Store
