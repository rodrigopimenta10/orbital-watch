# Build output - regenerated by every build, deployed as an artifact
dist/

# Upstream response cache - machine-local, restored in CI via actions/cache
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Working documents between local AI assistants -- not portfolio content.
HANDOFF-KIRO.md

# Interrupted atomic writes in the snapshot dir. refresh-snapshot.yml
# runs `git add seed/`, so a crash-orphaned temp file would otherwise be
# committed by automation.
seed/*.tmp

# Local editor/agent settings. Ignored here rather than relying on a personal
# global gitignore, so it stays ignored on any clone.
.claude/settings.local.json

# OS
.DS_Store
